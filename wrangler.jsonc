{
  // Darts Counter auf Cloudflare Workers.
  // Statische Seite aus public/, Worker (src/worker.js) nur für /api/*.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "darts",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Nur die eigene Domain, keine öffentliche *.workers.dev-Adresse.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "darts.pfleger.work", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "darts",
      // Database ID aus dem Cloudflare-Dashboard (D1, Standort EU)
      "database_id": "55a2143c-1430-437c-8ca3-5735e4c98f9d"
    }
  ],
  "vars": {
    // Zero-Trust-Team, z. B. "https://pfleger.cloudflareaccess.com"
    "TEAM_DOMAIN": "",
    // Optional: Application Audience (AUD) Tag der Access-Anwendung
    "POLICY_AUD": ""
  },
  "observability": { "enabled": true }
}
